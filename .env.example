# ---------------------------------------------------------------------------
#  ecom platform · environment template
#
#  Copy to `.env` and adjust for your host:
#     cp .env.example .env
#
#  Every value below is optional — the compose file falls back to these
#  defaults when `.env` is absent.
# ---------------------------------------------------------------------------

# --- host ports (change these if a port is already taken) -------------------
API_PORT=8080
ADMIN_UI_PORT=8081
APP_MINI_PORT=8082
APP_WEB_PORT=8083
DB_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL ------------------------------------------------------------
DB_NAME=ecom
DB_USER=postgres
DB_PASSWORD=postgres

# --- Redis -----------------------------------------------------------------
# Leave empty to disable authentication (fine for a private docker network).
REDIS_PASSWORD=

# --- Security --------------------------------------------------------------
# MUST be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=ecom-platform-dev-secret-key-change-me-32bytes-min

# --- Payments --------------------------------------------------------------
# Master key for encrypting payment channel credentials at rest (AES-GCM).
# Any string of 16+ characters; rotating it requires re-entering every key.
ECOM_PAY_SECRET=
# Publicly reachable base URL. Stripe and Alipay refuse relative callback URLs,
# so this must be the real host in production (https://shop.example.com).
ECOM_PUBLIC_URL=http://localhost:18080

# --- File storage ----------------------------------------------------------
# local  -> files land in the `ecom-uploads` docker volume, served at /uploads
# s3     -> any S3-compatible bucket (AWS S3, MinIO, Aliyun OSS S3 gateway)
STORAGE_TYPE=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ecom
S3_CUSTOM_DOMAIN=
